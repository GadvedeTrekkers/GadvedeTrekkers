PORT=10000

# Supabase — Get these from https://supabase.com/dashboard
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin credentials — Change password for production!
ADMIN_API_KEY=generate_random_api_key
ADMIN_USERS=[{"username":"admin","password":"change_this_password","name":"Admin","role":"Super Admin"}]

# JWT Secret — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_strong_random_secret_at_least_32_characters

# CORS — Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Gmail — For email notifications
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Backend URL — For keep-alive service (production only)
BACKEND_URL=https://your-backend-url.onrender.com
NODE_ENV=development
