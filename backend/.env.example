# ─────────────────────────────────────────────────────────────────
#  Gadvede Trekkers — Backend Environment Variables
#  Copy this file to backend/.env and fill in real values.
#  Never commit backend/.env to version control.
# ─────────────────────────────────────────────────────────────────

PORT=10000

# Backend URL for keep-alive pings (set to your deployed backend URL in production)
# Local: http://localhost:10000
# Production: https://admin.gadvede.com
BACKEND_URL=

# Node environment (development or production)
NODE_ENV=development

# Supabase project credentials (found in Supabase Dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin API key — must match VITE_ADMIN_API_KEY in frontend .env
ADMIN_API_KEY=

# Admin users — JSON array of admin accounts
# Format: [{"username":"admin","password":"yourpassword","name":"Display Name","role":"Super Admin"}]
ADMIN_USERS=

# JWT secret — any long random string for signing admin tokens
JWT_SECRET=

# Comma-separated list of allowed CORS origins.
# Add your Render frontend URL here after deployment.
CORS_ORIGIN=http://localhost:5173,https://gadvede.com,https://www.gadvede.com

# Gmail credentials for sending emails
GMAIL_USER=
GMAIL_APP_PASSWORD=
