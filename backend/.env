PORT=10000

# Supabase — fill in real values on Render dashboard
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin credentials — fill in real values on Render dashboard
ADMIN_API_KEY=your_admin_api_key
ADMIN_USERS=[{"username":"admin","password":"your_password","name":"Admin","role":"Super Admin"}]
JWT_SECRET=your_jwt_secret

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://gadvede.com,https://www.gadvede.com

# Gmail — fill in real values on Render dashboard
GMAIL_USER=your_gmail
GMAIL_APP_PASSWORD=your_gmail_app_password
