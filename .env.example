# ─────────────────────────────────────────────────────────────────
#  Gadvede Trekkers — Frontend Environment Variables
#  Copy this file to .env for local development.
#  For production (Render), set these in the Render dashboard.
# ─────────────────────────────────────────────────────────────────

# Full URL of the Express backend (no trailing slash).
# Local dev  : http://localhost:10000
# Production : https://gadvede-backend.onrender.com  (your Render backend URL)
VITE_API_BASE_URL=

# Admin API key — must match ADMIN_API_KEY in backend/.env
VITE_ADMIN_API_KEY=

# Supabase project credentials (public/anon key — safe to expose in frontend).
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
